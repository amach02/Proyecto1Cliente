@{
    ViewData["Title"] = "Carrito de Préstamo";
}

<div class="container mt-4">
    @Html.AntiForgeryToken()
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Carrito de Préstamo</h2>
        <a asp-controller="EspecimenApi" asp-action="Index" class="btn btn-outline-secondary">
            Volver al inventario
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <table class="table table-hover table-striped mb-0 align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Código ID</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody id="tablaCarrito">
                    <tr id="filaVacia">
                        <td colspan="2" class="text-center text-muted py-4">
                            No hay especímenes en el carrito.
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <div class="d-flex justify-content-end mt-3">
        <button id="btnConfirmar" class="btn btn-primary" disabled onclick="confirmarCarrito()">
            Confirmar préstamo
        </button>
    </div>
</div>

@section Scripts {
    <script>
        const CARRITO_KEY = 'carrito_especimenes';

        function obtenerCarrito() {
            return JSON.parse(localStorage.getItem(CARRITO_KEY) || '[]');
        }

        function renderizarCarrito() {
            const carrito = obtenerCarrito();
            const tbody = document.getElementById('tablaCarrito');
            const btnConfirmar = document.getElementById('btnConfirmar');
            const filaVacia = document.getElementById('filaVacia');

            // Limpiar filas anteriores excepto la de vacío
            tbody.querySelectorAll('tr.fila-item').forEach(f => f.remove());

            if (carrito.length === 0) {
                filaVacia.style.display = '';
                btnConfirmar.disabled = true;
                return;
            }

            filaVacia.style.display = 'none';
            btnConfirmar.disabled = false;

            carrito.forEach(item => {
                const tr = document.createElement('tr');
                tr.className = 'fila-item';
                tr.innerHTML = `
                    <td><strong>${item.codigoId}</strong></td>
                    <td class="text-center">
                        <button class="btn btn-sm btn-outline-danger" onclick="quitarDelCarrito('${item.id}')">
                            Quitar
                        </button>
                    </td>
                `;
                tbody.appendChild(tr);
            });
        }

        function quitarDelCarrito(id) {
            let carrito = obtenerCarrito();
            carrito = carrito.filter(e => e.id !== id);
            localStorage.setItem(CARRITO_KEY, JSON.stringify(carrito));
            renderizarCarrito();
        }

        async function confirmarCarrito() {
            const carrito = obtenerCarrito();
            if (carrito.length === 0) return;

            const ids = carrito.map(e => parseInt(e.id));

            const resp = await fetch('/EspecimenApi/ConfirmarCarrito', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(ids)
            });

            if (resp.ok) {
                localStorage.removeItem(CARRITO_KEY);
                alert('Préstamo confirmado. Los especímenes han sido marcados como prestados.');
                window.location.href = '/EspecimenApi/Index';
            } else {
                alert('Ocurrió un error al confirmar el préstamo. Intente de nuevo.');
            }
        }

        // Cargar al entrar a la página
        renderizarCarrito();
    </script>
}
