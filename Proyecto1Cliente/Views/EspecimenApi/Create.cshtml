@model Proyecto1Cliente.Models.Domain.Especimen

@{
    ViewData["Title"] = "Registrar Nuevo Espécimen";
}

<div class="container mt-4" style="max-width: 800px;">
    <div class="card shadow p-4 border-top border-4 border-success">
        <h3 class="mb-4">Registrar Nuevo Espécimen</h3>

        <form asp-action="Create" method="post">

            <div class="row mb-3">
                <div class="col-md-6">
                    <label class="form-label fw-bold">Código ID (Etiqueta) <span class="text-danger">*</span></label>
                    <input asp-for="CodigoId" class="form-control" placeholder="Ej: UCR-ENT-001" required />
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-bold">Fecha de Recolección</label>
                    <input asp-for="FechaRecoleccion" type="date" class="form-control" />
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-6">
                    <label class="form-label fw-bold">Localización (Geografía)</label>
                    <input asp-for="LocalizacionRecoleccion" class="form-control" placeholder="Ej: Turrialba, Cartago" />
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-bold">Estado <span class="text-danger">*</span></label>
                    <select asp-for="Estado" class="form-select" required>
                        <option value="disponible">Disponible</option>
                        <option value="pendiente_identificacion" selected>Pendiente de Identificación</option>
                        <option value="prestado">Prestado</option>
                    </select>
                </div>
            </div>

            <div class="mb-4">
                <label class="form-label fw-bold">ID Especie Taxonómica</label>
                <select asp-for="IdEspecie" class="form-select">
                    <option value="">Seleccione una especie</option>

                    @foreach (var especie in ViewBag.Especies)
                    {
                        <option value="@especie.IdEspecie">
                            @especie.Genero @especie.EspecieNombre
                        </option>
                    }
                </select>
            </div>

            <div class="p-4 bg-light border rounded mb-4">
                <h5 class="text-primary mb-3"><i class="bi bi-geo-alt-fill"></i> Ubicación Física en Laboratorio</h5>

                <div class="mb-3">
                    <select id="tipoUbicacion" class="form-select border-primary" onchange="toggleUbicacion()">
                        <option value="">-- Seleccione un lugar --</option>
                        <option value="seco">Gaveta</option>
                        <option value="liquido">Vial</option>
                    </select>
                </div>

                <div id="bloqueGaveta" class="d-none">
                    <label class="form-label text-success fw-bold">ID de la Gaveta Destino</label>
                    <select asp-for="IdGaveta"
                            class="form-select border-success"
                            id="inputGaveta">

                        <option value="">
                            Seleccione una gaveta
                        </option>

                        @foreach (var gaveta in ViewBag.Gavetas)
                        {
                            <option value="@gaveta.IdGaveta">
                                @gaveta.Codigo
                            </option>
                        }
                    </select>
                </div>

                <div id="bloqueVial" class="d-none">
                    <label class="form-label text-info text-dark fw-bold">ID del Vial Destino</label>
                    <select asp-for="IdVial"
                            class="form-select border-info"
                            id="inputVial">

                        <option value="">
                            Seleccione un vial
                        </option>

                        @foreach (var vial in ViewBag.Viales)
                        {
                            <option value="@vial.IdVial">
                                @vial.Codigo
                            </option>
                        }
                    </select>
                </div>
            </div>

            <div class="d-flex justify-content-between mt-4">
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
                <button type="submit" class="btn btn-success px-5 fw-bold">Guardar Espécimen</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function toggleUbicacion() {
            var tipo = document.getElementById('tipoUbicacion').value;
            var bloqueGaveta = document.getElementById('bloqueGaveta');
            var bloqueVial = document.getElementById('bloqueVial');
            var inputGaveta = document.getElementById('inputGaveta');
            var inputVial = document.getElementById('inputVial');

            if (tipo === 'seco') {
                bloqueGaveta.classList.remove('d-none');
                bloqueVial.classList.add('d-none');
                inputVial.value = ''; // Limpiamos si cambia de opinión
            } else if (tipo === 'liquido') {
                bloqueVial.classList.remove('d-none');
                bloqueGaveta.classList.add('d-none');
                inputGaveta.value = '';
            } else {
                bloqueGaveta.classList.add('d-none');
                bloqueVial.classList.add('d-none');
                inputGaveta.value = '';
                inputVial.value = '';
            }
        }
    </script>
}