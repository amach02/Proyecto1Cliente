@model IEnumerable<Proyecto1Cliente.Models.Domain.Especimen>

@{
    ViewData["Title"] = "Inventario de Especímenes";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Inventario del Laboratorio</h2>
        <div class="d-flex gap-2">
            <a asp-action="Buscar" class="btn btn-outline-primary fw-bold">🔍 Buscar</a>
        </div>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-body p-0">
            <table class="table table-hover table-striped mb-0 align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Código ID</th>
                        <th>Fecha Recolección</th>
                        <th>Localización</th>
                        <th>Estado</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td><strong>@item.CodigoId</strong></td>
                                <td>@(string.IsNullOrEmpty(item.FechaRecoleccion) ? "N/A" : item.FechaRecoleccion)</td>
                                <td>@item.LocalizacionRecoleccion</td>
                                <td>
                                    @{
                                        var badgeClass = item.Estado?.ToLower() == "disponible" ? "bg-success" :
                                                         (item.Estado?.ToLower() == "prestado" ? "bg-warning text-dark" : "bg-secondary");
                                    }
                                    <span class="badge @badgeClass">@item.Estado</span>
                                </td>
                                <td class="text-center">
                                    <div class="btn-group" role="group">
                                        <a asp-action="Details" asp-route-id="@item.IdEspecimen" class="btn btn-sm btn-primary">
                                            Ver fotos
                                        </a>
                                        <a asp-action="Comentarios" asp-route-id="@item.IdEspecimen" class="btn btn-sm btn-info">
                                            Comentarios
                                        </a>
                                        <a asp-action="Plantas" asp-route-id="@item.IdEspecimen" class="btn btn-sm btn-success">
                                            Plantas
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-4">No hay especímenes registrados en el sistema.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @if (ViewBag.TotalPaginas > 1)
    {
        <nav aria-label="Navegacion de paginas">
            <ul class="pagination justify-content-center">
                <li class="page-item @(ViewBag.PaginaActual == 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-pagina="@(ViewBag.PaginaActual - 1)">Anterior</a>
                </li>

                @for (int i = 1; i <= ViewBag.TotalPaginas; i++)
                {
                    <li class="page-item @(ViewBag.PaginaActual == i ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-pagina="@i">@i</a>
                    </li>
                }

                <li class="page-item @(ViewBag.PaginaActual == ViewBag.TotalPaginas ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-pagina="@(ViewBag.PaginaActual + 1)">Siguiente</a>
                </li>
            </ul>
        </nav>
    }
</div>